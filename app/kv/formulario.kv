# Estilo de los campos de texto del formulario (con borde).
<Campo@MDTextField>:
    mode: 'outlined'
    multiline: False
    size_hint_y: None
    height: dp(56)

# PANTALLA PUBLICAR (formulario): se abre con «Publicar un punto» en la Lista.
# Las validaciones y el guardado están en screens/formulario.py.
<PantallaFormulario>:
    md_bg_color: app.theme_cls.surfaceColor

    MDBoxLayout:
        orientation: 'vertical'

        MDTopAppBar:
            type: 'small'
            MDTopAppBarLeadingButtonContainer:
                # BOTÓN «X» (cerrar): cancela y vuelve a la lista.
                MDActionTopAppBarButton:
                    icon: 'close'
                    on_release: root.cancelar()
            MDTopAppBarTitle:
                text: 'Cuéntanos qué viste'

        MDScrollView:
            do_scroll_x: False
            MDBoxLayout:
                orientation: 'vertical'
                adaptive_height: True
                padding: [dp(16), dp(8), dp(16), dp(16)]
                # espacio extra para el texto de ayuda bajo cada campo
                spacing: dp(22)

                TextoSuave:
                    text: ('Publicarás como ' + app.nombre_usuario + '. ' if app.con_sesion else 'Necesitas una cuenta para publicar. ') + 'Los campos con * son obligatorios.'

                # CAMPO «Local o persona que vende».
                Campo:
                    id: nombre
                    MDTextFieldLeadingIcon:
                        icon: 'store'
                    MDTextFieldHintText:
                        text: 'Local o persona que vende *'
                    MDTextFieldHelperText:
                        text: 'Ej.: Ferretería Los Aromos'
                        mode: 'persistent'

                Titulo:
                    text: 'Tipo de punto'
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    # BOTÓN «Tienda o bencinera» (tipo de punto).
                    MDButton:
                        style: 'filled' if root.es_tienda else 'outlined'
                        on_release: root.es_tienda = True
                        MDButtonIcon:
                            icon: 'storefront-outline'
                        MDButtonText:
                            text: 'Tienda o bencinera'
                    # BOTÓN «Particular»: alguien que vende en su casa.
                    MDButton:
                        style: 'outlined' if root.es_tienda else 'filled'
                        on_release: root.es_tienda = False
                        MDButtonIcon:
                            icon: 'account'
                        MDButtonText:
                            text: 'Particular'

                Titulo:
                    text: '¿Qué vende?'
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(6)
                    # BOTÓN «Pellet» (qué vende).
                    MDButton:
                        style: 'filled' if root.combustible == 'pellet' else 'outlined'
                        on_release: root.combustible = 'pellet'
                        MDButtonText:
                            text: 'Pellet'
                    # BOTÓN «Leña seca» (qué vende).
                    MDButton:
                        style: 'filled' if root.combustible == 'lena' else 'outlined'
                        on_release: root.combustible = 'lena'
                        MDButtonText:
                            text: 'Leña seca'
                    # BOTÓN «Ambos»: pellet y leña.
                    MDButton:
                        style: 'filled' if root.combustible == 'ambos' else 'outlined'
                        on_release: root.combustible = 'ambos'
                        MDButtonText:
                            text: 'Ambos'

                Titulo:
                    text: 'Sector'
                # BOTÓN de sector: abre el menú con los sectores de Temuco.
                MDButton:
                    style: 'tonal'
                    on_release: root.abrir_comunas(self)
                    MDButtonIcon:
                        icon: 'map-marker'
                    MDButtonText:
                        text: root.comuna

                # CAMPO «Dirección exacta».
                Campo:
                    id: direccion
                    MDTextFieldLeadingIcon:
                        icon: 'map-marker-outline'
                    MDTextFieldHintText:
                        text: 'Dirección exacta *'
                    MDTextFieldHelperText:
                        text: 'Ej.: Manuel Montt 850'
                        mode: 'persistent'

                Titulo:
                    text: 'Ubicación en el mapa *'
                # BOTÓN «Ubicación en el mapa»: abre la pantalla para marcar el lugar (kv/elegir.kv).
                MDCard:
                    id: caja_ubicacion
                    style: 'outlined'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [dp(14), dp(10), dp(10), dp(10)]
                    spacing: dp(10)
                    radius: [dp(12)]
                    on_release: app.ir_a('elegir')
                    MDIcon:
                        icon: 'map-marker-check' if root.lat is not None else 'map-marker-plus-outline'
                        theme_icon_color: 'Custom'
                        icon_color: app.C_HAY if root.lat is not None else app.theme_cls.primaryColor
                        pos_hint: {'center_y': .5}
                    MDLabel:
                        text: 'Ubicación marcada' if root.lat is not None else 'Toca para marcarla en el mapa'
                        bold: root.lat is not None
                        adaptive_height: True
                        pos_hint: {'center_y': .5}
                    MDIcon:
                        icon: 'chevron-right'
                        pos_hint: {'center_y': .5}

                Titulo:
                    text: '¿Había stock cuando fuiste?'
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    # BOTÓN «Sí había»: había stock cuando fuiste.
                    MDButton:
                        theme_width: 'Custom'
                        size_hint_x: .5
                        style: 'filled' if root.hay else 'outlined'
                        theme_bg_color: 'Custom' if root.hay else 'Primary'
                        md_bg_color: app.C_HAY if root.hay else (0, 0, 0, 0)
                        on_release: root.hay = True
                        MDButtonIcon:
                            icon: 'check'
                            theme_icon_color: 'Custom' if root.hay else 'Primary'
                            icon_color: 1, 1, 1, 1
                        MDButtonText:
                            text: 'Sí había'
                            theme_text_color: 'Custom' if root.hay else 'Primary'
                            text_color: 1, 1, 1, 1
                    # BOTÓN «No había»: oculta los campos de sacos y precio.
                    MDButton:
                        theme_width: 'Custom'
                        size_hint_x: .5
                        style: 'outlined' if root.hay else 'filled'
                        theme_bg_color: 'Primary' if root.hay else 'Custom'
                        md_bg_color: (0, 0, 0, 0) if root.hay else app.C_NOHAY
                        on_release: root.hay = False
                        MDButtonIcon:
                            icon: 'close'
                            theme_icon_color: 'Primary' if root.hay else 'Custom'
                            icon_color: 1, 1, 1, 1
                        MDButtonText:
                            text: 'No había'
                            theme_text_color: 'Primary' if root.hay else 'Custom'
                            text_color: 1, 1, 1, 1

                # Sacos y precio solo tienen sentido si había stock
                MDBoxLayout:
                    id: caja_stock
                    orientation: 'vertical'
                    spacing: dp(22)
                    size_hint_y: None
                    height: self.minimum_height if root.hay else 0
                    opacity: 1 if root.hay else 0
                    disabled: not root.hay
                    # CAMPO «Sacos que quedaban» (solo números).
                    Campo:
                        id: sacos
                        input_filter: 'int'
                        MDTextFieldLeadingIcon:
                            icon: 'package-variant'
                        MDTextFieldHintText:
                            text: 'Sacos que quedaban *'
                        MDTextFieldHelperText:
                            text: 'Aunque sea aproximado'
                            mode: 'persistent'
                    # CAMPO «Precio por saco» (solo números).
                    Campo:
                        id: precio
                        input_filter: 'int'
                        MDTextFieldLeadingIcon:
                            icon: 'currency-usd'
                        MDTextFieldHintText:
                            text: 'Precio por saco de leña *' if root.combustible == 'lena' else 'Precio por saco de 15 kg *'
                        MDTextFieldHelperText:
                            text: 'Solo números, ej.: 5290'
                            mode: 'persistent'

                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    # CAMPO «Hora en que pasaste» (formato HH:MM).
                    Campo:
                        id: hora
                        MDTextFieldLeadingIcon:
                            icon: 'clock-outline'
                        MDTextFieldHintText:
                            text: 'Hora en que pasaste'
                        MDTextFieldHelperText:
                            text: 'HH:MM (vacío = ahora)'
                            mode: 'persistent'
                    # BOTÓN «Ahora»: pone la hora actual.
                    MDButton:
                        style: 'tonal'
                        pos_hint: {'top': 1}
                        on_release: root.poner_hora_actual()
                        MDButtonText:
                            text: 'Ahora'

                Titulo:
                    text: 'Horario de atención'
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    # CAMPO «Abre» (hora de apertura).
                    Campo:
                        id: desde
                        text: '09:00'
                        MDTextFieldHintText:
                            text: 'Abre'
                    # CAMPO «Cierra» (hora de cierre).
                    Campo:
                        id: hasta
                        text: '20:00'
                        MDTextFieldHintText:
                            text: 'Cierra'

                # Aquí aparece el mensaje de error de la validación.
                MDLabel:
                    id: error
                    text: ''
                    font_style: 'Body'
                    role: 'large'
                    bold: True
                    theme_text_color: 'Custom'
                    text_color: app.C_NOHAY
                    adaptive_height: True

                # BOTÓN «Publicar»: valida todo y muestra el resumen antes de publicar (revisar).
                BotonAncho:
                    on_release: root.revisar()
                    MDButtonIcon:
                        icon: 'send'
                    TextoBoton:
                        text: 'Publicar'
